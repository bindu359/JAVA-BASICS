class Cloth3 
{
		String cloth_color;
		int cloth_cost;
		String cloth_size;
		Cloth3(String	cloth_color,String	cloth_cost,int	cloth_size){
		this.cloth_color=cloth_color;
		this.cloth_cost=cloth_cost;
		this.cloth_size=cloth_size;
		}
	public static void main(String[] args) 
	{
	Cloth3	c3=new	Cloth3("Red","L",2000);
		System.out.println(c3.cloth_color);
		System.out.println(c3.cloth_cost);
		System.out.println(c3.cloth_size);
	}
}
